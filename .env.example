# .env.example
# Salin ke .env dan sesuaikan nilainya

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=scholarNexus2024

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_DAYS=7

# LLM Provider: "gemini" (default) atau "deepseek"
LLM_PROVIDER=gemini

# Google Gemini (Reasoning & Embedding)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# DeepSeek (Alternative LLM Provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ArXiv API Configuration
ARXIV_RATE_LIMIT_RPS=3.0
ARXIV_SIMILARITY_THRESHOLD=0.55

# Application Settings
LOG_LEVEL=INFO
UPLOAD_MAX_SIZE_MB=50
